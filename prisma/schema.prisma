generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== USERS (login accounts) =====
enum Role {
  ADMIN
  RECEPTIONIST
  HR
  DOCTOR
}

enum DoctorSpecialty {
  GENERAL_PHYSICIAN
  OPHTHALMOLOGY
  GYNECOLOGY
  PEDIATRICS
  SURGERY
}

model User {
  id            String           @id @default(cuid())
  username      String           @unique
  email         String?          @unique
  passwordHash  String
  fullName      String
  role          Role
  specialty     DoctorSpecialty?
  qualification String?
  pmdcNumber    String?
  isActive      Boolean          @default(true)
  lastLogin     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  createdPatients  Patient[]      @relation("CreatedBy")
  updatedPatients  Patient[]      @relation("UpdatedBy")
  assignedPatients Patient[]      @relation("AssignedDoctor")
  doctorVisits     Visit[]        @relation("DoctorVisits")
  prescriptions    Prescription[] @relation("DoctorPrescriptions")
  auditLogs        AuditLog[]
}

// ===== PATIENTS =====
enum DepartmentType {
  ER
  OPD
  IND
}

enum PatientStatus {
  ACTIVE
  DISCHARGED
  ARCHIVED
  DECEASED
}

model Patient {
  id              String         @id @default(cuid())
  mrNumber        String         @unique
  fullName        String
  guardianName    String?
  guardianCnic    String?
  guardianMobile  String?
  age             Int
  ageUnit         String         @default("Years")
  gender          String
  dateOfBirth     DateTime?
  cnicNumber      String?
  mobile          String
  address         String         @db.Text
  photoUrl        String?
  department      DepartmentType
  registerType    String
  serviceRequired String?
  patientCount    Int
  status          PatientStatus  @default(ACTIVE)
  isVisible       Boolean        @default(true)
  visitDate       DateTime       @default(now())
  visitTime       String
  tokenNumber     Int?
  consentAt       DateTime?
  followUpDate    DateTime?
  followUpReason  String?
  followUpDone    Boolean        @default(false)
  patientComment  String?        @db.Text
  consentGiven    Boolean        @default(false)
  disposal        String?
  fee             Int?
  details         String?        @db.Text
  
  createdById     String
  createdBy       User           @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById     String?
  updatedBy       User?          @relation("UpdatedBy", fields: [updatedById], references: [id])
  
  assignedDoctorId String?
  assignedDoctor   User?         @relation("AssignedDoctor", fields: [assignedDoctorId], references: [id])

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  archivedAt      DateTime?

  visits          Visit[]
  documents       PatientDocument[]
  prescriptions   Prescription[]

  @@index([mrNumber])
  @@index([department, visitDate])
  @@index([status])
  @@index([assignedDoctorId, visitDate])
}

model Visit {
  id              String         @id @default(cuid())
  patientId       String
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitNumber     Int            @default(1)
  visitDate       DateTime       @default(now())
  department      DepartmentType
  serviceRequired String?
  reason          String?
  diagnosis       String?        @db.Text
  prescription    String?        @db.Text
  doctorNotes     String?        @db.Text
  followUpDate    DateTime?
  
  doctorId        String?
  doctor          User?          @relation("DoctorVisits", fields: [doctorId], references: [id])
  createdAt       DateTime       @default(now())

  prescriptions   Prescription[]

  @@index([patientId, visitNumber])
}

model PatientDocument {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileType   String
  uploadedAt DateTime @default(now())
}

// ===== MR NUMBER TRACKING =====
model MRCounter {
  id           String         @id @default(cuid())
  department   DepartmentType
  year         Int
  month        Int
  currentCount Int            @default(0)

  @@unique([department, year, month])
}

// ===== APPOINTMENTS =====
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id            String            @id @default(cuid())
  patientName   String
  mobile        String
  email         String?
  department    String
  doctorName    String?
  preferredDate DateTime
  status        AppointmentStatus @default(SCHEDULED)
  notes         String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

// ===== AUDIT LOG =====
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// ===== DEPARTMENTS =====
model Department {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  description  String  @db.Text
  iconName     String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
}

model TokenCounter {
  id           String @id @default(cuid())
  date         String @unique
  currentCount Int    @default(0)
}

// ===== HR MODULE =====
model HospitalLicense {
  id            String                @id @default(cuid())
  name          String                @unique
  issuanceDate  DateTime?
  expiryDate    DateTime?
  rackLocation  String?
  documentUrl   String?
  notes         String?               @db.Text
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  history       LicenseHistory[]
  notifications LicenseNotification[]
}

model LicenseHistory {
  id           String          @id @default(cuid())
  licenseId    String
  license      HospitalLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  issuanceDate DateTime
  expiryDate   DateTime
  documentUrl  String?
  notes        String?         @db.Text
  recordedAt   DateTime        @default(now())
}

model LicenseNotification {
  id        String          @id @default(cuid())
  licenseId String
  license   HospitalLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  message   String          @db.Text
  isRead    Boolean         @default(false)
  createdAt DateTime        @default(now())
}

model Employee {
  id               String       @id @default(cuid())
  fullName         String
  age              Int
  designation      String
  department       String?
  shift            String
  joiningDate      DateTime
  photoUrl         String?
  phone            String?
  cnic             String?
  address          String?      @db.Text
  isActive         Boolean      @default(true)
  employmentStatus String       @default("Active")
  leftDate         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  attendance       Attendance[]
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       String
  status     String
  checkIn    String?
  checkOut   String?
  notes      String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, date])
}

// ===== PRESCRIPTIONS =====
enum ConsultationStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
}

model Prescription {
  id               String             @id @default(cuid())
  patientId        String
  patient          Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId          String?
  visit            Visit?             @relation(fields: [visitId], references: [id], onDelete: SetNull)
  doctorId         String
  doctor           User               @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  templateType     DoctorSpecialty
  status           ConsultationStatus @default(COMPLETED)
  
  vitals           Json?              
  clinicalFindings Json?             
  diagnosis        String?            @db.Text
  medications      Json?              
  instructions     String?            @db.Text
  followUpDays     Int?
  
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([patientId])
  @@index([doctorId, createdAt])
}