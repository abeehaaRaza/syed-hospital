generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===== USERS (login accounts) =====
enum Role {
  ADMIN
  RECEPTIONIST
  HR
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String?   @unique
  passwordHash String
  fullName     String
  role         Role
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdPatients Patient[]  @relation("CreatedBy")
  updatedPatients Patient[]  @relation("UpdatedBy")
  auditLogs       AuditLog[]
}

// ===== PATIENTS =====
enum DepartmentType {
  ER
  OPD
  IND
}

enum PatientStatus {
  ACTIVE
  DISCHARGED
  ARCHIVED
  DECEASED
}

model Patient {
  id             String         @id @default(cuid())
  mrNumber       String         @unique
  fullName       String
 guardianName   String?
  guardianCnic   String?
  guardianMobile String?
    age            Int
  ageUnit        String    @default("Years")
  gender         String
  dateOfBirth    DateTime?
  cnicNumber     String?
  mobile         String
  address        String         @db.Text
  photoUrl       String?
  department     DepartmentType
  registerType   String
  serviceRequired String?
  patientCount   Int
  status         PatientStatus  @default(ACTIVE)
  isVisible      Boolean        @default(true)
  visitDate      DateTime       @default(now())
  visitTime      String
  tokenNumber    Int?
  consentAt      DateTime?
  followUpDate   DateTime?
  followUpReason String?
  followUpDone   Boolean   @default(false)
  patientComment String?        @db.Text
  consentGiven   Boolean        @default(false)
  disposal       String?
  fee            Int?
  details        String?        @db.Text
  createdById    String
  createdBy      User           @relation("CreatedBy", fields: [createdById], references: [id])
  updatedById    String?
  updatedBy      User?          @relation("UpdatedBy", fields: [updatedById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  archivedAt     DateTime?

  visits    Visit[]
  documents PatientDocument[]

  @@index([mrNumber])
  @@index([department, visitDate])
  @@index([status])
}

model Visit {
  id           String    @id @default(cuid())
  patientId    String
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitNumber  Int       @default(1)
  visitDate    DateTime  @default(now())
  department   DepartmentType
  serviceRequired String?
  reason       String?
  diagnosis    String?   @db.Text
  prescription String?   @db.Text
  doctorNotes  String?   @db.Text
  followUpDate DateTime?
  createdAt    DateTime  @default(now())

  @@index([patientId, visitNumber])
}

model PatientDocument {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileType   String
  uploadedAt DateTime @default(now())
}

// ===== MR NUMBER TRACKING =====
model MRCounter {
  id           String         @id @default(cuid())
  department   DepartmentType
  year         Int
  month        Int
  currentCount Int            @default(0)

  @@unique([department, year, month])
}

// ===== APPOINTMENTS =====
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id            String            @id @default(cuid())
  patientName   String
  mobile        String
  email         String?
  department    String
  doctorName    String?
  preferredDate DateTime
  status        AppointmentStatus @default(SCHEDULED)
  notes         String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

// ===== AUDIT LOG (legal protection) =====
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// ===== DEPARTMENTS (public site) =====
model Department {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  description  String  @db.Text
  iconName     String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
}
model TokenCounter {
  id           String   @id @default(cuid())
  date         String   @unique
  currentCount Int      @default(0)
}

model HospitalLicense {
  id             String    @id @default(cuid())
  name           String    @unique
  issuanceDate   DateTime?
  expiryDate     DateTime?
  rackLocation   String?
  documentUrl    String?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  history        LicenseHistory[]
  notifications  LicenseNotification[]
}

model LicenseHistory {
  id          String          @id @default(cuid())
  licenseId   String
  license     HospitalLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  issuanceDate DateTime
  expiryDate  DateTime
  documentUrl String?
  notes       String?         @db.Text
  recordedAt  DateTime        @default(now())
}

model LicenseNotification {
  id          String          @id @default(cuid())
  licenseId   String
  license     HospitalLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  message     String          @db.Text
  isRead      Boolean         @default(false)
  createdAt   DateTime        @default(now())
}

model Employee {
  id           String       @id @default(cuid())
  fullName     String
  age          Int
  designation  String
  department   String?
  shift        String
  joiningDate  DateTime
  photoUrl     String?
  phone        String?
  cnic         String?
  address      String?      @db.Text
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  attendance   Attendance[]
}

model Attendance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        String
  status      String
  checkIn     String?
  checkOut    String?
  notes       String?
  createdAt   DateTime  @default(now())

  @@unique([employeeId, date])
}